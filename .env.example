# Backend secrets are never sent to the browser. Copy this file to .env.
MIMAS_ENV=development
DATABASE_URL=
# Existing shared employer key is retained only for historical data after migration.
COMPANY_KEY=demo-company
# Separate private admin credential for manual company approvals.
MIMAS_ADMIN_KEY=
MIMAS_LLM_PROVIDER=yandex
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=deepseek-v4.1-flash
MIMAS_LLM_TIMEOUT_SECONDS=60
# Estimated application guard, not a Yandex billing limit. Video storage billed separately.
MIMAS_AI_MONTHLY_LIMIT_RUB=1000
# Private S3-compatible bucket; use a different bucket for local development.
MIMAS_S3_ENDPOINT=https://storage.yandexcloud.net
MIMAS_S3_REGION=ru-central1
MIMAS_S3_BUCKET=
MIMAS_S3_ACCESS_KEY=
MIMAS_S3_SECRET_KEY=
MIMAS_MAX_ASSESSMENTS_PER_DAY=0
MIMAS_MAX_CANDIDATES_PER_DAY=0
MIMAS_MAX_COMPANY_APPLICATIONS_PER_DAY=20
# Set only after backing up the existing production PostgreSQL database.
MIMAS_MIGRATION_BACKUP_CONFIRMED=0
