# Copy to .env. Never commit keys. API calls are made only from the backend.
AI_MODE=mock
MIMAS_LLM_PROVIDER=gemini
GEMINI_API_KEY=
MIMAS_GEMINI_MODEL=gemini-3.8-flash
MIMAS_GEMINI_QUESTION_THINKING=low
MIMAS_GEMINI_FOLLOW_UP_THINKING=medium
MIMAS_GEMINI_EVALUATION_THINKING=medium
MIMAS_GEMINI_VERIFICATION_THINKING=medium
MIMAS_GEMINI_CODE_REVIEW_THINKING=high
MIMAS_LLM_TIMEOUT_SECONDS=60
GROQ_API_KEY=
# Set a model available in your Groq Free account before enabling live mode.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Local demo only. Change this before sharing access.
COMPANY_KEY=demo-company
# Empty uses existing data/demo.sqlite3 via SQLAlchemy.
DATABASE_URL=
